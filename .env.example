# Secrets only. Thresholds and non-secret settings belong in config/*.yaml.

# Telegram: create a bot with @BotFather, message it, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC asks automated clients to identify themselves: "<app name> <contact email>"
EDGAR_USER_AGENT=trade_to_go your-email@example.com

# Tiingo free tier (personal use): https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Moomoo OpenD gateway
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Optional: override the project root (defaults to the repo this package lives in)
# TTG_ROOT=
